# Modelo no formato "provedor:modelo" (lido por langchain.chat_models.init_chat_model).
# Local (padrão do tutorial):  ollama:qwen3-4b
# Nuvem (ex.):                 openai:gpt-4.1-mini   (exige OPENAI_API_KEY e langchain-openai)
LLM_MODELO=ollama:qwen3-4b
OLLAMA_URL=http://localhost:11434
# Opcional: threads do llama.cpp (deixe vazio para o Ollama decidir).
OLLAMA_NUM_THREAD=

# Fase 2 — LangWatch. Sem LANGWATCH_API_KEY o app roda sem traces.
# Self-hosted (usado na gravação): http://localhost:5560 | Nuvem: https://app.langwatch.ai
LANGWATCH_API_KEY=
LANGWATCH_ENDPOINT=http://localhost:5560
